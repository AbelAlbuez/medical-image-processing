# Entornos virtuales
class-filter-image/venv/
venv/
.venv/
env/

# Resultados y datos grandes (límite GitHub 100 MB)
class-filter-image/result/
class-filter-image/comparison_results/
# Archivos NIfTI sin comprimir (suelen ser muy grandes)
class-filter-image/samples/*.nii

# Resultados taller-segmentation (NIfTI generados)
taller-segmentation/results/

# Salidas taller-segmentacion-second (NIfTI y figuras generados)
taller-segmentacion-second/output/
# Entorno virtual del taller
taller-segmentacion-second/scripts/.venv/

# Salidas umbrales-ITK (NIfTI y PNG generados)
umbrales-ITK/output/
# Muestras: versionar .nii.gz; ignorar .nii sin comprimir (GitHub rechaza >100 MB)
umbrales-ITK/samples/*.nii

# Salidas registro-second-part (PNG y mosaicos generados)
registro-second-part/output/

# RegLib_C20_Data: ignorar outputs/resultados generados (se conserva la carpeta con .gitkeep)
# El entorno virtual RegLib_C20_Data/.venv/ ya queda cubierto por el patrón global .venv/
RegLib_C20_Data/results/*
!RegLib_C20_Data/results/.gitkeep
RegLib_C20_Data/output/

# Archivos comprimidos
*.zip

# Cache de Python
__pycache__/

# LaTeX auxiliares
*.log
*.aux
*.toc
*.out

# macOS
.DS_Store

# Ignorar dataset de registro completo
RegistrationData/
